t=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="c545"><mxGeometry y="46" width="340" height="8" as="geometry"/></mxCell><mxCell id="c548" value="View でゲーム ⇔ ImGui を切替" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c545"><mxGeometry y="54" width="340" height="20" as="geometry"/></mxCell><mxCell id="c549" value="切替時に押していたボタンは離すまで無視" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c545"><mxGeometry y="74" width="340" height="20" as="geometry"/></mxCell><mxCell id="c550" value="Filter" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#B85450;fontColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c470" target="c545"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="134.1"/><mxPoint x="1530" y="708"/></Array></mxGeometry></mxCell><mxCell id="c551" value="keybindings.json (例)  ※名前はパッドのボタン基準&lt;br&gt;{ &quot;profiles&quot;: {&lt;br&gt;  &quot;Default&quot;: {&lt;br&gt;    &quot;LeftStick&quot;: { &quot;keys&quot;: { &quot;up&quot;: &quot;W&quot;, &quot;down&quot;: &quot;S&quot;, &quot;left&quot;: &quot;A&quot;, &quot;right&quot;: &quot;D&quot; } },&lt;br&gt;    &quot;RightStick&quot;: { &quot;mouse&quot;: { &quot;type&quot;: &quot;delta&quot;, &quot;scale&quot;: 0.0025 } },&lt;br&gt;    &quot;A&quot;: &quot;F&quot;, &quot;B&quot;: &quot;Space&quot;, &quot;X&quot;: &quot;R&quot;, &quot;Y&quot;: &quot;E&quot;,&lt;br&gt;    &quot;RB&quot;: &quot;MouseLeft&quot;, &quot;RT&quot;: &quot;Shift+MouseLeft&quot;,&lt;br&gt;    &quot;LB&quot;: &quot;MouseRight&quot;, &quot;LT&quot;: &quot;Shift+MouseRight&quot;,&lt;br&gt;    &quot;RS&quot;: &quot;Q&quot;, &quot;LS&quot;: &quot;X&quot;, &quot;DPadUp&quot;: &quot;Up&quot;, ... },&lt;br&gt;  &quot;KeyboardOnly&quot;: { &quot;RightStick&quot;: { &quot;keys&quot;: {矢印}, &quot;type&quot;: &quot;rate&quot; },&lt;br&gt;    &quot;DPadUp&quot;: &quot;1&quot;, ... } } }" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="420" y="852" width="340" height="240" as="geometry"/></mxCell><mxCell id="c552" value="読み方のルール&lt;br&gt;・InputManager::Update は Main だけが呼ぶ (1 フレームの最初)&lt;br&gt;・そのフレーム中 ControlState は不変 → ジョブからも安全に読める&lt;br&gt;・短押し / 長押し / 押した時刻はエンジン (ControlState) が判定&lt;br&gt;・「攻撃」「回避」などの意味づけはゲーム側 (→ 9. 操作)&lt;br&gt;・マウス移動量は dt を掛けない。GetLookDelta が rate / delta を合算&lt;br&gt;・UI 中はカーソル表示 + クリック判定、ゲーム中は固定&lt;br&gt;・振動は予約だけ。次の Update で Main が反映&lt;br&gt;・Suspend 復帰時は状態をクリア / 毎フレームのヒープ確保 0" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="800" y="812" width="720" height="190" as="geometry"/></mxCell><mxCell id="c553" value="PlayerController  (→ 9)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="380" height="74" as="geometry"/></mxCell><mxCell id="c554" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;poin
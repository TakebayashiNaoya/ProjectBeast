;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c453"><mxGeometry y="26" width="340" height="20" as="geometry"/></mxCell><mxCell id="c455" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="c453"><mxGeometry y="46" width="340" height="8" as="geometry"/></mxCell><mxCell id="c456" value="+ Release(res, fenceValue) : void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c453"><mxGeometry y="54" width="340" height="20" as="geometry"/></mxCell><mxCell id="c457" value="+ Flush(completedFence) : void  // Main" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c453"><mxGeometry y="74" width="340" height="20" as="geometry"/></mxCell><mxCell id="c458" value="解放は遅延" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#B85450;fontColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c445" target="c453"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c459" value="読み込みの流れ (例: Texture)&lt;br&gt;① IOThread : ファイル → バイト列&lt;br&gt;② Job : Decode (DDS 解析など)&lt;br&gt;③ Job : CreateGpu → ID3D12Resource 生成 + DescriptorAllocator で SRV&lt;br&gt;④ GpuUploader : Copy Queue で転送 → Fence&lt;br&gt;⑤ Main : ResourceManager::Update で Fence 完了を確認 → Ready&lt;br&gt;&lt;br&gt;依存 (Model → Texture) が全部 Ready で親も Ready。" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="340" height="190" as="geometry"/></mxCell><mxCell id="c460" value="ロードと解放の方針&lt;br&gt;・レベルのリソースは LevelLoadHandle の完了に含める → Start 時点で必ず Ready&lt;br&gt;・実行中に CreateObject する物は Level JSON の &quot;preload&quot; で先読み&lt;br&gt;・間に合わない場合は IsReady() が false の間は描かない (エラーにしない)&lt;br&gt;・Level Unload 後に UnloadUnused() → 参照がキャッシュだけの物を解放&lt;br&gt;・GPU リソースは DeferredReleaseQueue で Fence 完了後に解放&lt;br&gt;・アロケーターは作らない (new / CreateCommittedResource をそのまま使う)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="420" y="780" width="720" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
t;&lt;br&gt;ワーカー数は hardware_concurrency 任せにせず固定。" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1160" y="90" width="250" height="200" as="geometry"/></mxCell><mxCell id="c378" value="主な利用者&lt;br&gt;・Application : ParallelGameplay グループの Update (ParallelFor)&lt;br&gt;・エンジンの各処理 : アニメーション / Transform / カリング / パーティクル / UI バッチ&lt;br&gt;・RenderThread : コマンドリストの並列記録&lt;br&gt;・LevelManager : パース / デコード / 生成 + Awake (Schedule)&lt;br&gt;&lt;br&gt;要素数がチャンク 1 つ分以下なら分割せずその場で for 実行" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="518" width="700" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="7. リソース"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c379" value="リソース管理（ジョブで GPU リソースまで作る / アロケーター管理はしない）" style="text;html=1;fillColor=none;strokeColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="c380" value="Engine" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F5F9FF;strokeColor=#BBBBBB;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1520" height="900" as="geometry"/></mxCell><mxCell id="c381" value="ResourceManager" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex=
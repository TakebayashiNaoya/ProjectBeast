alAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1F4E79;labelBackgroundColor=none;" vertex="1" connectable="0" parent="c44"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="c46" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#1F4E79;fontColor=#1F4E79;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="1" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1F4E79;labelBackgroundColor=none;" vertex="1" connectable="0" parent="c46"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="c48" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#1F4E79;fontColor=#1F4E79;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="1" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1F4E79;labelBackgroundColor=none;" vertex="1" connectable="0" parent="c48"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="c50" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#1F4E79;fontColor=#1F4E79;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="1" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1F4E79;labelBackgroundColor=none;" vertex="1" connectable="0" parent="c50"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="c52" value="1 フレームの流れ (Application::Run)&lt;br&gt;1. Input::Update&lt;br&gt;2. GameStateMachine::Update  (遷移は予約制)&lt;br&gt;3. ResourceManager::Update / LevelManager::Update&lt;br&gt;    (同期点: ロード完了の受け取り・完成品を登録)&lt;br&gt;4. StartPendingObjects  (Start)&lt;br&gt;5. UpdateGroup(PreUpdate)&lt;br&gt;6. UpdateGroup(Gameplay)&lt;br&gt;6'. UpdateGroup(ParallelGameplay)  ← ParallelFor&lt;br&gt;7. Physics::Step&lt;br&gt;8. UpdateGroup(PostPhysics)&lt;br&gt;9. UpdateGroup(Camera)&lt;br&gt;10. UpdateGroup(Late)&lt;br&gt;11. UIContext::Update → CollectRenderItems&lt;br&gt;12. DestroyRequestedObjects  (OnDestroy → 破棄)&lt;br&gt;    + GPU 遅延解放 (Fence 完了分)&lt;br&gt;13. Renderer::BuildCommandList → RenderThread" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="420" height="260" as="geometry"/></mxCell><mxCell id="c53" value="ターゲット: Xbox One S (UWP Dev Mode「Game」分類)&lt;br&gt;CPU 4 コア占有 + 2 コア共有 / RAM 5GB / D3D12 FL12_0&lt;br&gt;&lt;br&gt;スレッド構成 (コア固定)&lt;br&gt;Core0 : Main    Core1 : Render&lt;br&gt;Core2-3 : Worker (高優先)&lt;br&gt;Core4-5 : Worker (低優先) + IO スレッド  ← 共有コア&lt;br&gt;&lt;br&gt;専用スレッドは Main / Render / IO のみ。&lt;br&gt;それ以外の並列処理はすべて JobSystem のジョブ。" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="490" y="424" width="440" height="190" as="geometry"/></mxCell><mxCell id
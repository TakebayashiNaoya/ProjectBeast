{
    "comment": "音符が拡縮する2Dエフェクト（発生位置はTitleEventMenuがロゴの位置と大きさから設定する。ロゴの左側用と右側用で2つ使うので、maxParticlesは片側あたりの数）",
    "duration": 0,
    "spawn":{
        "rate": 4.0,
        "maxParticles":4,
        "looping": true
    },
    "modules":[
        {
            "type": "InitLifetime",
            "lifetime": { "mode": "random", "min": 0.8, "max": 2.0 }
        },
        {
            "type": "ScaleOverLife",
            "uniform": true,
            "startScale": { "mode": "random", "min": 0.3, "max": 0.6 },
            "endScale": { "mode": "random", "min": 1.0, "max": 1.5 },
            "easing": "EaseOut"
        },
        {
            "type": "AlphaOverLife",
            "startAlpha": 1.0,
            "endAlpha": 0.0,
            "easing": "EaseIn"
        }
    ]
}
